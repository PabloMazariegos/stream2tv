#!/usr/bin/env python3
"""Entry point: transmite un canal de Twitch a la TV."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from stream2tv.cli import main

if __name__ == "__main__":
    sys.exit(main(plataforma_default="twitch", nombre_programa="twitch2tv"))
